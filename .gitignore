# Rust build artifacts
/target/
/src-tauri/target/
/apps/desktop/src-tauri/target/
**/*.rs.bk

# Node & Frontend dependencies and bundles
/node_modules/
/dist/
/build/
/apps/desktop/node_modules/
/apps/desktop/dist/
/apps/desktop/build/

# Local databases and SQLite journals (never track runtime local database instances)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local logs, crash dumps, and diagnostics
*.log
*.dmp
*.dump

# Local staging, temporary payloads, and transfer chunks (prevent runtime data leakage)
*.tmp
*.temp
*.stage
*.chunk
*.enc
*.dat
/staging/
/temp/
/payloads/
/recovery/

# Environment, secrets, and credentials (strict security isolation)
.env
.env.*
!.env.example
*.pem
*.key
*.secret
*.session
*.session-journal
credentials.json
auth.json
token.json

# Installer bundles and package distributions
/bundle/
/release/
*.msi
*.exe

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
