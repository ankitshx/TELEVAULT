# TeleVault Environment Configuration Template
# Copy to .env for local development / testing.
# NEVER commit your actual .env file or real session files!

# Telegram API credentials (from https://my.telegram.org)
TELEVAULT_API_ID=
TELEVAULT_API_HASH=
TELEVAULT_PHONE=

# Vault Channel IDs (optional overrides, created automatically on first run)
TELEVAULT_PRIMARY_CHANNEL_ID=
TELEVAULT_MIRROR_CHANNEL_ID=

# Opt-in flag for integration tests using a real Telegram account.
# WARNING: Only set to 1 when explicitly executing live account tests in throwaway test channels!
TV_LIVE_TEST=0
